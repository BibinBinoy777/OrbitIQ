# Absolute path required. No database is created during startup.
ORBITIQ_DATABASE_PATH=/absolute/path/to/orbitiq.sqlite3
# Used by Vite on the server; never expose secrets in VITE_* variables.
ORBITIQ_BACKEND_URL=http://127.0.0.1:8000
# Optional official CelesTrak GP endpoint; HTTPS and inherited proxy trust required.
ORBITIQ_CELESTRAK_URL=https://celestrak.org/NORAD/elements/gp.php
# Freshness is an epoch-age presentation policy, not prediction accuracy.
ORBITIQ_FRESH_HOURS=24
ORBITIQ_STALE_HOURS=72
# Local locked IERS resources only. Predictions are labelled and expire after
# 30 days of table age. Set measured_only to reject predicted EOP entirely.
ORBITIQ_EOP_POLICY=measured_or_predicted
# Sampling defaults; hard ceilings are 1000 points / 86400 seconds.
ORBITIQ_TRACK_MAX_SAMPLES=361
ORBITIQ_TRACK_MAX_DURATION_SECONDS=86400
