    "reference_precision": "C++ long double, 64 mantissa bits on this host; decimal output max_digits10, JSON expected values rounded to binary64. Also evaluated with 53-bit double.",
    "input_semantics": "Parse input km as binary64 then promote to long double before multiplying by 1000 to GeographicLib metres. Forward-generated controls are rounded once to binary64 km before Reverse.",
    "ellipsoid": {
      "a_m": 6378137,
      "inverse_flattening": 298.257223563
    },
    "coordinate_frame": "Geocentric Earth-fixed XYZ, aligned with conventional WGS84 axes; pure ellipsoid conversion, no EOP/time/frame rotation.",
    "outputs": {
      "latitude_deg": "Geodetic, north positive",
      "longitude_deg": "East positive; compare modulo 360 and normalize app output to [-180,180)",
      "altitude_km": "WGS84 ellipsoidal height, not sea level or terrain"
    },
    "license": "MIT/X11, full notice in phase611-source-notices.txt",
    "acquired_utc": "2026-10-19",
    "limitations": "Selected numerical implementation agreement, not observations or universal error bounds. Deep interior multi-root geometry is not refined. GeographicLib documented 7 nm bound for |h|<5000 km is not asserted for all high-altitude cases.",
    "tolerance_rationale": "Same original high-altitude component targets: 1e-9 degrees, 1e-7 km height. Far above measured double/long-double discrepancies. 1e-7 km roundtrip norm is an additional consistency check, not a replacement for component criteria."
