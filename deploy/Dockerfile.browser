# syntax=docker/dockerfile:1
# Accessibility tooling is locked with the frontend, but only the test library
# enters this browser runtime. No npm packages enter the API or static assets.
FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS accessibility-tools
WORKDIR /tools
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --ignore-scripts --strict-ssl=true
# Test runtime only; never part of the API or web release image.
FROM mcr.microsoft.com/playwright/python:v1.62.0-noble@sha256:aa81288e738725378becba5b3e06cb0f3a7f012a610e87e8d767a090ea3f740d
COPY --from=accessibility-tools /tools/node_modules/axe-core/axe.min.js /opt/axe/axe.min.js
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir playwright==1.62.0 greenlet==3.5.5 pyee==13.0.1
