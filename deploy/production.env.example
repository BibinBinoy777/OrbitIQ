# Placeholders only. Export or use Compose --env-file with a protected local copy.
ORBITIQ_RELEASE=replace-with-tested-commit-sha
ORBITIQ_DATA_DIRECTORY=/absolute/path/to/provisioned-durable-archive
ORBITIQ_ALLOWED_HOSTS=orbitiq.example.invalid,127.0.0.1
ORBITIQ_EOP_POLICY=measured_or_predicted
ORBITIQ_HTTP_BIND=127.0.0.1:8080
ORBITIQ_BUILD_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Optional compose.tls.yaml only; provision the certificate/key out of band.
# ORBITIQ_TLS_DIRECTORY=/absolute/path/to/protected-tls-files
# ORBITIQ_HTTPS_BIND=127.0.0.1:8443
